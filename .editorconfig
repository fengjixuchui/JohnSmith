root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,hpp,asm}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{md,yml,yaml}]
indent_style = space
indent_size = 2

[*.{sln,vcxproj,vcxproj.filters}]
end_of_line = crlf
indent_style = space
indent_size = 2
