PROJECT_NAME           = "JohnSmith Hypervisor"
PROJECT_BRIEF          = "Windows x64 research hypervisor"
OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO

INPUT                  = README.md docs include src
FILE_PATTERNS          = *.md *.h *.c
RECURSIVE              = YES
EXCLUDE                = build tests tasks .codegraph docs/references
USE_MDFILE_AS_MAINPAGE = README.md

JAVADOC_AUTOBRIEF      = NO
MARKDOWN_SUPPORT       = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = build/docs/doxygen-warnings.log

OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
GENERATE_LATEX         = NO
QUIET                  = YES

HAVE_DOT               = NO
